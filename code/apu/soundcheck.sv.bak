`timescale 1ns/1ps
`default_nettype none 

////////////////////////////////////////////////////////////////////////////////
// Top-Level Sound Check
////////////////////////////////////////////////////////////////////////////////
module sound_check_top (
    input  logic clk,         // System clock (e.g., 50 MHz)
    input  logic rst_n,       // Active-low reset
    output logic i2c_scl,     // I2C clock to WM8731
    inout  wire  i2c_sda,     // I2C data (bidirectional)
    output logic config_done  // High when configuration is complete
);

    // Instantiate the WM8731 configurator
    wm8731_configurator u_config (
        .clk(clk),
        .rst_n(rst_n),
        .config_done(config_done),
        .i2c_scl(i2c_scl),
        .i2c_sda(i2c_sda)
    );
    
endmodule

////////////////////////////////////////////////////////////////////////////////
// WM8731 Configurator
////////////////////////////////////////////////////////////////////////////////
module wm8731_configurator (
    input  logic        clk,
    input  logic        rst_n,
    output logic        config_done,
    output logic        i2c_scl,
    inout  wire         i2c_sda
);

    localparam int NUM_REGISTERS = 11;

    // Register Command Definitions
    localparam logic [15:0] REG_RESET              = 16'h1E00; // Reset CODEC
    localparam logic [15:0] REG_LEFT_LINE_IN       = 16'h0017; // Left line in: 0dB, no mute
    localparam logic [15:0] REG_RIGHT_LINE_IN      = 16'h0217; // Right line in: 0dB, no mute
    localparam logic [15:0] REG_LEFT_HP_OUT        = 16'h0497; // Left headphone out
    localparam logic [15:0] REG_RIGHT_HP_OUT       = 16'h0697; // Right headphone out
    localparam logic [15:0] REG_ANALOG_AUDIO_PATH  = 16'h0800; // Analog audio path control
    localparam logic [15:0] REG_DIGITAL_AUDIO_PATH = 16'h0A00; // Digital audio path control
    localparam logic [15:0] REG_POWER_DOWN         = 16'h0C00; // Power down control (all on)
    localparam logic [15:0] REG_DIGITAL_AUDIO_IF   = 16'h0E51; // Digital audio interface format
    localparam logic [15:0] REG_SAMPLING_CTRL      = 16'h0100; // Sampling control
    localparam logic [15:0] REG_ACTIVE_CTRL        = 16'h1201; // Activate interface

    // Internal Signals (driven only by always_ff blocks)
    logic [6:0]  reg_index;
    logic [15:0] command_word;
    logic        transfer_enable;
    logic        transfer_done;

    // Instantiate I2C Master Module
    i2c_master u_i2c (
        .clk(clk),
        .rst_n(rst_n),
        .enable(transfer_enable),
        .data(command_word),
        .done(transfer_done),
        .scl(i2c_scl),
        .sda(i2c_sda)
    );

    // State machine for register configuration (only one always_ff driver)
    always_ff @(posedge transfer_done or negedge rst_n) begin
        if (!rst_n) begin
            reg_index       <= 7'd0;
            config_done     <= 1'b0;
            transfer_enable <= 1'b1;
        end else begin
            if (reg_index < (NUM_REGISTERS - 1))
                reg_index <= reg_index + 7'd1;
            else begin
                config_done     <= 1'b1; // All registers programmed
                transfer_enable <= 1'b0;
            end
        end
    end

    // Command Word Generation (only one always_ff driver)
    always_ff @(posedge transfer_done or negedge rst_n) begin
        if (!rst_n)
            command_word <= REG_RESET;
        else begin
            case (reg_index)
                7'd0:  command_word <= REG_RESET;
                7'd1:  command_word <= REG_LEFT_LINE_IN;
                7'd2:  command_word <= REG_RIGHT_LINE_IN;
                7'd3:  command_word <= REG_LEFT_HP_OUT;
                7'd4:  command_word <= REG_RIGHT_HP_OUT;
                7'd5:  command_word <= REG_ANALOG_AUDIO_PATH;
                7'd6:  command_word <= REG_DIGITAL_AUDIO_PATH;
                7'd7:  command_word <= REG_POWER_DOWN;
                7'd8:  command_word <= REG_DIGITAL_AUDIO_IF;
                7'd9:  command_word <= REG_SAMPLING_CTRL;
                7'd10: command_word <= REG_ACTIVE_CTRL;
                default: command_word <= 16'h0000;
            endcase
        end
    end

endmodule

////////////////////////////////////////////////////////////////////////////////
// I2C Master
////////////////////////////////////////////////////////////////////////////////
module i2c_master (
    input  logic        clk,      // System clock
    input  logic        rst_n,    // Active-low reset
    input  logic        enable,   // Begin transaction when high
    input  logic [15:0] data,     // 16-bit command word (address+data)
    output logic        done,     // Pulses high when transaction complete
    output logic        scl,      // I2C clock output
    inout  wire         sda       // I2C data (open-drain)
);

    // State encoding for the I2C state machine
    typedef enum logic [2:0] {
        I2C_IDLE,
        I2C_START,
        I2C_SEND,
        I2C_WAIT_ACK,
        I2C_STOP,
        I2C_COMPLETE
    } state_t;

    state_t state, next_state;
    logic [4:0] bit_count, next_bit_count;
    logic sda_reg, next_sda_reg;
    logic scl_reg, next_scl_reg;

    // Drive the open-drain output. When sda_reg is 1, we release the line.
    assign sda = sda_reg ? 1'bz : 1'b0;
    assign scl = scl_reg;
    // We drive done combinationally from the state.
    assign done = (state == I2C_COMPLETE);

    // Sequential block: update state and output registers
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state     <= I2C_IDLE;
            bit_count <= 5'd15;
            sda_reg   <= 1'b1;
            scl_reg   <= 1'b1;
        end else begin
            state     <= next_state;
            bit_count <= next_bit_count;
            sda_reg   <= next_sda_reg;
            scl_reg   <= next_scl_reg;
        end
    end

    // Combinational block: determine next state and outputs
    always_comb begin
        // Default assignments: hold current values
        next_state      = state;
        next_bit_count  = bit_count;
        next_sda_reg    = sda_reg;
        next_scl_reg    = scl_reg;

        case (state)
            I2C_IDLE: begin
                next_scl_reg = 1'b1;
                next_sda_reg = 1'b1;
                if (enable)
                    next_state = I2C_START;
            end

            I2C_START: begin
                next_scl_reg = 1'b1;
                next_sda_reg = 1'b0;
                next_state   = I2C_SEND;
                next_bit_count = 5'd15; // (Re)initialize bit counter
            end

            I2C_SEND: begin
                // Drive SDA with the current bit (MSB first)
                next_sda_reg = data[bit_count];
                // Lower SCL to clock out the bit
                next_scl_reg = 1'b0;
                if (bit_count == 0)
                    next_state = I2C_WAIT_ACK;
                else begin
                    next_state = I2C_SEND;
                    next_bit_count = bit_count - 1;
                end
            end

            I2C_WAIT_ACK: begin
                next_sda_reg = 1'b1; // Release SDA for ACK from slave
                next_scl_reg = 1'b1;
                next_state = I2C_STOP;
            end

            I2C_STOP: begin
                next_scl_reg = 1'b1;
                next_sda_reg = 1'b0; // Pull SDA low then release it to form a stop condition
                next_state = I2C_COMPLETE;
            end

            I2C_COMPLETE: begin
                next_scl_reg = 1'b1;
                next_sda_reg = 1'b1;
                next_state = I2C_IDLE; // Ready for next transaction
            end

            default: next_state = I2C_IDLE;
        endcase
    end

endmodule
